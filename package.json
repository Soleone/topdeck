{
  "name": "topdeck",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "deploy": "vercel --prod",
    "dev": "remix vite:dev",
    "start": "remix-serve ./build/server/index.js",
    "typecheck": "tsc",
    "prisma": "npx prisma generate && npx prisma migrate dev",
    "test": "npx jest",
    "postinstall": "npx prisma generate --no-engine && npx prisma migrate deploy",
    "media:capture": "node scripts/capture-media.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/client": "^5.3.1",
    "@prisma/extension-accelerate": "^0.6.2",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@remix-run/node": "2.16.7",
    "@remix-run/react": "2.16.7",
    "@remix-run/serve": "2.16.7",
    "@vercel/remix": "2.16.7",
    "argon2": "^0.31.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cn": "^0.4.0",
    "isbot": "^5.1.0",
    "lucide-react": "^1.56.0",
    "motion": "^14.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remix-auth": "^3.5.1",
    "remix-auth-form": "^1.3.0",
    "superjson": "^1.13.3",
    "tailwind-merge": "^3.7.0",
    "tiny-invariant": "^1.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@remix-run/dev": "2.16.7",
    "@soleone/showcase": "^0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^8.38.0",
    "jest": "^29.7.0",
    "prisma": "^5.3.1",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.1.1",
    "typescript": "^5.1.6",
    "vite": "^6.4.4",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "@remix-run/react": "2.16.7",
    "@remix-run/server-runtime": "2.16.7",
    "@remix-run/node": "2.16.7"
  }
}
